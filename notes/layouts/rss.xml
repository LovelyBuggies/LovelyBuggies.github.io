{{- $pages := .RegularPagesRecursive -}}
{{- if or .IsHome (eq .Section "types") }}{{ $pages = site.RegularPages }}{{ end -}}
{{- if eq .Kind "taxonomy" }}{{ $pages = where site.RegularPages "Params.tags" "ne" nil }}{{ end -}}
{{- $posts := partial "blog-posts.html" $pages -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if not .IsHome }}{{ partial "archive-title.html" . }} · {{ end }}{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description | default site.Params.description }}</description>
    <language>{{ site.Language.LanguageCode }}</language>
    {{ with .OutputFormats.Get "rss" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
    {{ range first 1 $posts }}<lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>{{ end }}
    {{ range $posts }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid>{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Description | default (.Summary | plainify) }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
